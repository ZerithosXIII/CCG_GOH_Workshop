{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	(include "/properties/tank_crew.ext")
	{props "tank" "turret" "wheeled"   "tractor" "tractor_light"    "ammo_open_top_turret" "sq_at_light" "vision_lev03" "muzzle_75mm_76mm_sides" "open_top" "muzzle_hmg_m2hb"}
	
	; armor notes
	; wheels 0.5mm
	; gun 20mm
	; shields 2-8mm

	("armoredcar_tier2")

	
	
	
	
	
	

	
	

	
	
	
	
	
	

	
	
	
	

	

	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	




	
	{extension "mw_19323bd73bea.mdl"}
	(include "mw_19323bd73bea.ext")

	{targetclass "armoredcar"}
	{targetSelector "tank_light"}
	{patherId "sdkfz232"}

	{extender "shield" {on}}

	{boarder
		
		
		{anm "driver"
			{forward {begin "board_MiddleArmor"} {end "seat_m8_driver"}}
			{reverse {end "emit_tank_1"}}
		}
		
		
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	

	{sensor
		{visor "main"
			{vision "recon_main"}
			{bone "foresight1"}
		}
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

	

	

{boarder
			{door "emit1"}
			{door "emit2"}
			
			
		}
	

{boarder
			{door "emit1"}
			{door "emit2"}
			
			
		}
	

{boarder
			{door "emit1"}
			{door "emit2"}
			
			
		}
	

{boarder
			{door "emit1"}
			{door "emit2"}
			
			
		}
	

{boarder
			{door "emit1"}
			{door "emit2"}
			
			
		}

	{boarder
		
		
		{anm "left"
			{forward {begin "board_tank_left"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "gunner_l"
			{forward {begin "board_tank_left"} {end "seat_m18_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "gunner_r"
			{forward {begin "board_tank_right"} {end "seat_m18_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "charger_l"
			{forward {begin "board_tank_left"} {end "seat_m18_charger"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "charger_r"
			{forward {begin "board_tank_right"} {end "seat_m18_charger"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "charger2_l"
			{forward {begin "board_tank_left"} {end "seat_m18_commander"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "charger2_r"
			{forward {begin "board_tank_right"} {end "seat_m18_commander"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		
	}
	{boarder
		{door "emit0"}
		{door "emit2"}
		{door "emit3"}
		
		
		
	}
	
	{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}
	
	{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}
	
	{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}
	{boarder
		{door "emit1"}
		{door "emit2"}
		;{door "emit3"}
		
		
		;{link "emit3" "commander" {anm "right"} {forward putoff} {reverse puton}}
	}
	{placer
			{place "driver" {group "crew"} {linkbone "driver"} {turnoff {shadow} {sensor}}}
		}
	{placer
		{place "gunner"
			{group "crew"}
			{visor "main"}
			{linkbone "gunner"}
			{turnoff {sensor}}
			;{openForCrush}
		}
	}
	{placer
		{place "charger"
			{group "crew"}
			{visor "around"}
			{linkbone "charger"}
			{turnoff {sensor}}
			;{openForCrush}
		}
	}
	{placer
		{place "charger2"
			{group "crew"}
			{linkbone "charger2"}
			{turnoff}
			;{openForCrush}
		}
	}
	{boarder
{link "emit1" "driver" {anm "driver"} {forward putoff} {reverse puton}}

{link "emit2" "driver" {anm "driver"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "gunner" {anm "gunner_l"} {forward putoff} {reverse puton}}

{link "emit3" "gunner" {anm "gunner_r"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "charger" {anm "charger_l"} {forward putoff} {reverse puton}}

{link "emit3" "charger" {anm "charger_r"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "charger2" {anm "charger2_l"} {forward putoff} {reverse puton}}

{link "emit3" "charger2" {anm "charger2_r"} {forward putoff} {reverse puton}}
}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))
	("seat_human" place(seat5) bone(seat05) door(emit7)  animation(armor1))
	("seat_human" place(seat6) bone(seat06) door(emit8)  animation(armor1))

	

	{Weaponry
		("restore_ik_time")
		
		
		
	
{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m1a2_m18" filling "ammo bulletusa_76x539 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(2.5)
				dispersion(0.25)
			)
		
{foresight "foresight1"}
}

{place "mgun1"
			{type "coaxial"}
			{gunner "charger"}
			{charger "charger"}
			{LinkBone "mgun3"}
			{LinkAnimation "off"}
			("abm_mgun")
			{ai_in_manual}
			{basic}
		}

{place "mgun"
			{type "aa"}
			{weapon "browning_m2" filled}
			{gunner "charger2"}
			{charger "charger2"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{ai_in_manual}
			{basic}
		}
}

	{mass 7890}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_car"
			speed(88) ;----------------------------------Max speed.
			speedatmaxturn(22) ;-------------------------Max speed at max turn. 
			reverse(17) ;--------------------------------Max speed in Reverse.
			weight(7.89) ;-------------------------------Weight in Tonnes.
			power(110) ;---------------------------------Horse Power.
			fuel(200) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(500) ;---------------------------------Range in Kilometers.
		)
	}

	
	
	
	
	

















{bone "gun_rot"
		{limits -10 20}
		{speed2 6}
	}

{bone "turret"
		("turret_medium" power_traverse(24))
	}

{bone "mgun_a_rot1"
		{speed2 30}
	}

{bone "mgun_a_rot2"
		{limits -13 85}
		{speed2 60}
	}

{bone "mgun_1_rot1"
		{limits -15 15}
		{speed2 60}
	}

{bone "mgun_1_rot2"
		{limits -10 30}
		{speed2 60}
	}

{props "with_gun"}

{extender "inventory" {box
{item "bulletusa_76x539 apcbche" 29}

{item "bulletusa_76x539 he" 11}

{item "bulletusa_76x539 hvap" 2}

{item "bulletusa_76x539 sm" 2}

{item "ammo hmgun_usa" 700}

{item "ammo mgun_usa belt" 750}

{item "browning_m19a4" filling "ammo mgun_usa belt" 250 {user "mgun1"}}

{item "satchel_charge_usa" 1}
}
{weapon "mgun1" {mask "mountable"}}
}

{sensor
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}
}