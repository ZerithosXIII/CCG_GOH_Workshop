		{door "emit1"}
		{door "emit2"}
		
		
	}
	
	{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}
	
	{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}
	
	{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}
	{boarder
		
		
		
		
		
		{anm "armor2"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
	
{anm "mw_crew_left"
			{forward {begin "board_tank_left"}
{end "seat_m4_gunner"}
}
			{reverse {end "emit_tank_1_hold"}}
		}

{anm "mw_crew_right"
			{forward {begin "board_tank_right"}
{end "seat_m4_gunner"}
}
			{reverse {end "emit_tank_1_hold"}}
		}
}
	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner3" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner"
			{group "crew"}
			{visor "main"}
		}
	}
	{placer
		{place "charger"
			{group "crew"}
			{visor "none"}
		}
	}
	{placer
		{place "commander"
			{group "crew"}
			{visor "around"}
		}
	}
	{boarder
{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}

{link "emit2" "driver" {anm "left"} {forward putoff} {reverse puton}}

{link "emit3" "driver" {anm "right"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit1" "gunner3"  {anm "co_driver"} {forward putoff} {reverse puton}}

{link "emit2" "gunner3" {anm "left"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "gunner" {anm "mw_crew_left"} {forward putoff} {reverse puton}}

{link "emit3" "gunner" {anm "mw_crew_right"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "charger" {anm "mw_crew_left"} {forward putoff} {reverse puton}}

{link "emit3" "charger" {anm "mw_crew_right"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "commander" {anm "mw_crew_left"} {forward putoff} {reverse puton}}

{link "emit3" "commander" {anm "mw_crew_right"} {forward putoff} {reverse puton}}
}
	("gunner_open" place(gunner2) bone(gunner2) visorbone(mgun_rot) door(emit4) door2(emit5) anm_left(gunner2) anm_right(gunner2) group(passenger))

	{boarder
		{anm "driver"
			{forward {begin "board_t26_driver"} {end "pose_t26_driver"} {base "open_driver"}}
			{reverse {end "board_t26_driver" -1} {base "open_driver" -1}}
		}
		{anm "co_driver"
			{forward {begin "board_tank_right"}{base "open_co_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_co_driver"}}
		}
		{anm "left"
			{forward {begin "board_tank_left"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	
	
	
	

	{extender "shield" {on}}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
					;147 rounds ;30/70% AP/HE		;historical 30% AP, 60% HE, 10% CAN
			
			{item "ammo mgun_usa belt" 6250}		;6750 rounds
			{item "satchel_charge_usa" 1}
			
		
{item "bulletusa_75x350 apcbche" 18}

{item "bulletusa_75x350 he" 68}

{item "bulletusa_75x350 wp" 10}

{item "ammo hmgun_usa" 200}

{item "ammo mgun_usa belt" 4250}
}
	}

	{Weaponry
		("restore_ik_time")
		
		
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_m3" filling "ammo bulletusa_75x350 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3)
				dispersion(0.3)
			)
		
{foresight "foresight1"}
}
{place "mgun1"
			{type "hull"}
			{weapon "browning_m19a4_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		
	
{place "mgun2"
			{type "coaxial"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}

{place "mgun"
			{type "aa"}
			{weapon "browning_m2" filled}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
}

	{mass 15200}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.2) len(0.59))
		("mobility_tank"
			speed(58) ;-----------Max speed when fully accelerated on road, km/h.
			reverse(24) ;---------Max speed in reverse on road, km/h.
			traverse(37) ;--------Track traverse, per second, in degrees.
			weight(15.2) ;--------Weight in Tonnes.
			power(220) ;----------Engine Power, in hp.
			track(3.5) ;----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(340) ;-----------Fuel capacity in Litres.
			type(fuel) ;----------Fuel type. (diesel OR fuel)
			range(160) ;----------Range in km, off-road.
		)
	}

	
	
	
	



















{bone "gun_rot"
		{limits -10 25}
		{speed2 6}
	}

{bone "turret"
		("turret_medium" power_traverse(24))
	}

{bone "cupola_ring"
		{speed2 50}
	}

{bone "mgun_a_rot1"
		{limits -10 10}
		{speed2 60}
	}

{bone "mgun_a_rot2"
		{limits -10 65}
		{speed2 60}
	}

{props "with_gun"}
}
