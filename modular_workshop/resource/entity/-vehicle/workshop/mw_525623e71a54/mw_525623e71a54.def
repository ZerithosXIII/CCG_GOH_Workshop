			{entity "76mm_rus_he"}
			{Linkbone "ammo009"}
			{handlebone "body"}
		}
		{place "ammo010"
			{entity "76mm_rus_he"}
			{Linkbone "ammo010"}
			{handlebone "body"}
		}
		{place "ammo011"
			{entity "76mm_rus_he"}
			{Linkbone "ammo011"}
			{handlebone "body"}
		}
		{place "ammo012"
			{entity "76mm_rus_he"}
			{Linkbone "ammo012"}
			{handlebone "body"}
		}
		{place "ammo013"
			{entity "76mm_rus_he"}
			{Linkbone "ammo013"}
			{handlebone "body"}
		}
		{place "ammo014"
			{entity "76mm_rus_he"}
			{Linkbone "ammo014"}
