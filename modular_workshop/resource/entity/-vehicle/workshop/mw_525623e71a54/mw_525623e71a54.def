		}
		{place "ammo015"
			{entity "76mm_rus_he"}
			{Linkbone "ammo015"}
			{handlebone "body"}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_pak39" filling "bulletger_75_l43 apcbche" 1}
			
			
				; general setting used by Tank Destroyers, which conserves more accuracy on the rotation of the main gun
	 ; 	spreading depending on the speed of "body", "gun" volumes
	{AccuracyByMotion
		{MaxLinearSpeed 10}				;km/h
		{ByLinearSpeed 0.4}
		{MaxAngularSpeed 8}				;deg/s
		{ByAngularSpeed 0.50}
		{DisorderTime 0.25}				;s
		{OrderTime 2.25}						;s
	}


		
{foresight "foresight1"}

{gunner "gunner"}

{charger "charger" minWorkers 1}

{LinkBone "gun"}

{rotate}
}
	
{place "mgun1"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "cmdmg_mgun_rot2"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
}

	{mass 10000}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.55))
		("mobility_tank"
			speed(40) ;----------Max speed when fully accelerated on road, km/h.
			reverse(12) ;--------Max speed in reverse on road, km/h.
			traverse(25) ;-------Track traverse, per second, in degrees.
			weight(10.0) ;-------Weight in Tonnes.
			power(85) ;----------Engine Power, in hp.
			track(4.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(120) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(150) ;---------Range in km, off-road.
		)
	}

	
	{bone "turret"
		{limits -15 15}
		{speed2 8}
	}

{props "-muzzle_75mm_76mm_sides" "muzzle_75mm_76mm"}

{volume "mantlet"
		{thickness 75}
		{CastSteel 0.8063}
		{tags "armor"}
	}

{bone "gun_rot"
		
		
	}

{bone "gun_rot"
{limits -3 25}

{speed2 10}
}

{sensor {visor "cmdmg_top2" {vision "human"} {bone "cmdmg_mgun_rot2"}}}

{props "hatch"}

{bone "cmdmg_mgun_a_rot2" {speed2 180}}

{bone "cmdmg_mgun_a_rot3" {speed2 90}}

{props "-turret"}
}