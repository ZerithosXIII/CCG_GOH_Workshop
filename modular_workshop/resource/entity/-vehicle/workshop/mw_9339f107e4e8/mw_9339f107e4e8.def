{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "medium"    "sq_armor_medium" "open_top" "with_gun" "muzzle_37mm_40mm_auto" "vision_lev02" "sq_autocannon"}
	
	{extension "mw_9339f107e4e8.mdl"}
	(include "mw_9339f107e4e8.ext")

	;SDL

	; armor notes
	; tracks and wheels 20mm
	; gun 25mm

	("tank_medium_tier2")

	("tracks" repair(30) thickness(20))
	

	
	
	
	
	
	
	
	
	
	

	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	{PatherId "sherman"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	
{boarder
		{anm "left"
			{forward {begin "board_tank"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank"}}
			{reverse {end "emit_tank_1_hold"}}
		}
	}

{boarder
		{door "emit0"}
		{door "emit2"}
		{door "emit3"}
		
		
		
	}

{boarder
		{door "emit1"}
		{door "emit2"}
		
		
	}

{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}

{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}

{boarder
		{door "emit2"}
		{door "emit3"}
		
		
	}
	("gunner_visible2")

	{boarder
		{anm "driver"
			{forward {begin "board_m4_driver"} {end "seat_m4_gunner"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver"}}
		}
		{anm "co_driver"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"} {base "open_co_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_co_driver"}}
		}
		{anm "left"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor2"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
	}

	{boarder
		
		
		{anm "gunner"
			{forward {begin "board_body"} {end "seat_m15a1_gunner"}}
			{reverse {end "emit_tank_1_hold" 1}}
		}
		{anm "gunner2"
			{forward {begin "board_body"} {end "seat_m15a1_gunner2"}}
			{reverse {end "emit_tank_1_hold" 1}}
		}
		{anm "charger"
			{forward {begin "board_body"} {end "seat_m15a1_charger"}}
			{reverse {end "emit_tank_1_hold" 1}}
		}
		{anm "gunner4"
			{forward {begin "board_body"} {end "pose_m3a1e1_gunner4"}}
			{reverse {end "emit_tank_1_hold" 1}}
		}
		{anm "passenger"
			{forward {begin "board_body"} {end "seat_passenger"}}
			{reverse {end "emit_body" 1}}
		}
	}
	{boarder
		{door "emit1"}
		
	}
	
	{boarder
		{door "emit3"}
		
	}
	
	{boarder
		{door "emit4"}
		
