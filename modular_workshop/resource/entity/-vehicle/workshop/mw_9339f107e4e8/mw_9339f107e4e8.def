		{door "emit2"}
		
	}
	{boarder
		{door "emit2"}
		
	}
	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner3" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner"
			{group "crew"}
			{visor "none"}
			{LinkBone "gunner"}
			{turnoff }
			;{openForCrush}
		}
	}
	{placer
		{place "gunner2"
			{group "crew"}
			{visor "none"}
			{LinkBone "gunner2"}
			{turnoff }
			;{openForCrush}
		}
	}
	{placer
		{place "charger"
			{group "crew"}
			{visor "none"}
			{LinkBone "charger"}
			{turnoff }
			;{openForCrush}
		}
	}
	{placer
		{place "charger2"
			{group "crew"}
			{visor "none"}
			{LinkBone "module_seat03"}
			{turnoff }
			;{openForCrush}
		}
	}
	{boarder
{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}

{link "emit2" "driver" {anm "left"} {forward putoff} {reverse puton}}

{link "emit3" "driver" {anm "right"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit1" "gunner3"  {anm "co_driver"} {forward putoff} {reverse puton}}

{link "emit2" "gunner3" {anm "left"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit3" "gunner" {anm "gunner"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit4" "gunner2" {anm "gunner2"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit3" "charger" {anm "charger"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit4" "charger2" {anm "passenger"} {forward putoff} {reverse puton}}
}
	("seat_human" place(seat1) bone(seat01) door(emit4) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5) animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6) animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit7) animation(armor2))

	{extender "inventory"
		{box
			{item "bulletusa_75x350 apcbche" 18}		;97 rounds ;20,70,10% AP,HE,WP
			{item "bulletusa_75x350 he" 68}
			{item "bulletusa_75x350 wp" 10}
						;300 rounds
						;4750 rounds
			{item "satchel_charge_usa" 1}
		
{item "bulletusa_37_auto apc" 40}

{item "bulletusa_37_auto he" 150}

{item "hmgun_usa api" 800}
}
	}

	{Weaponry
		("restore_ik_time")
		
		
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_m1a2" filling "ammo bulletusa_37_auto he" 10}
			{gunner "gunner"}
			{charger "charger charger2" minWorkers 1}
			("abm_dymamic_aa"
				zeroing(1.95)
				dispersion(0.24)
			)
		
{foresight "foresight1"}
}
{place "mgun1"
			{type "hull"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		
	
{place "mgun"
			{type "aa"}
			{Barrels 2}
			{weapon "browning_m2_x2" filling "hmgun_usa api" 400}
			{foresight "foresight14"}
			{gunner "gunner2"}
			{charger "charger charger2" minWorkers 1}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
}

	{mass 30300}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.0))
		("mobility_tank"
			speed(38) ;----------Max speed when fully accelerated on road, km/h.
			reverse(6) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(30.3) ;-------Weight in Tonnes.
			power(350) ;---------Engine Power, in hp.
			track(4) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(660) ;----------Fuel capacity in Litres.
			type(fuel) ;-------Fuel type. (diesel OR fuel)
			range(190) ;---------Range in km, off-road.
		)
	}

	
	
	
	
	

("ammo" args "module_ammo1")

("ammo" args "module_ammo2")





















{bone "gun_rot"
		{limits -5 88}
		{speed2 20}
	}

{bone "turret"
		{speed2 30}
	}

{props "with_gun"}

{sensor
		{visor "main"
			{vision "cannon_main"}
		}
	}
}