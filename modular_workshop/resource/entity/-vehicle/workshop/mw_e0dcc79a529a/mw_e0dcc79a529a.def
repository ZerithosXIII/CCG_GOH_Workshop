	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "commander" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner"
			{group "crew"}
			{visor "main"}
			{linkbone "gunner"}
			{turnoff {sensor}}
			;{openForCrush}
		}
	}
	{placer
		{place "charger"
			{group "crew"}
			{visor "around"}
			{linkbone "charger"}
