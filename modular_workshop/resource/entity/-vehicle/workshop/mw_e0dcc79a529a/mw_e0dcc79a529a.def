	{boarder
{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}

{link "emit2" "driver" {anm "left"} {forward putoff} {reverse puton}}

{link "emit3" "driver" {anm "right"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit1" "commander" {anm "co_driver"} {forward putoff} {reverse puton}}

{link "emit2" "commander" {anm "left"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "gunner" {anm "gunner_l"} {forward putoff} {reverse puton}}

{link "emit3" "gunner" {anm "gunner_r"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "charger" {anm "charger_l"} {forward putoff} {reverse puton}}

{link "emit3" "charger" {anm "charger_r"} {forward putoff} {reverse puton}}
}
	{boarder
{link "emit2" "charger2" {anm "charger2_l"} {forward putoff} {reverse puton}}

{link "emit3" "charger2" {anm "charger2_r"} {forward putoff} {reverse puton}}
}
	("seat_human" place(seat1) bone(seat01) door(emit4) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5) animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6) animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit7) animation(armor1))

	{sensor
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

	

	{extender "shield" {on}}

	{Weaponry
		("restore_ik_time")
		
		
		
	
{place "gun"
			{RestoreIKAfterAim}
			{weapon "150mm_sig33" filling "bulletger_150_l11 he" 1}
			
			
				; general setting used by most vehicles
	 ; 	spreading depending on the speed of "body", "gun" volumes
	{AccuracyByMotion
		{MaxLinearSpeed 10}				;km/h
		{ByLinearSpeed 0.25}
		{MaxAngularSpeed 8}				;deg/s
		{ByAngularSpeed 0.35}
		{DisorderTime 0.25}				;s
		{OrderTime 4.5}						;s
	}


		
{gunner "gunner"}

{charger "charger"}

{foresight "foresight1"}

{LinkBone "gun"}
}

{place "mgun1"
			{type "coaxial"}
			{gunner "charger"}
			{charger "charger"}
			{LinkBone "mgun3"}
			{LinkAnimation "off"}
			("abm_mgun")
			{ai_in_manual}
			{basic}
		}

{place "mgun"
			{type "aa"}
			{weapon "browning_m2" filled}
			{gunner "charger2"}
			{charger "charger2"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{ai_in_manual}
			{basic}
		}
}

	{mass 17690}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.64))
		("mobility_tank"
			speed(80) ;------------Max speed when fully accelerated on road, km/h.
			reverse(32) ;----------Max speed in reverse on road, km/h.
			traverse(40) ;---------Track traverse, per second, in degrees.
			weight(17.69) ;--------Weight in Tonnes.
			power(400) ;-----------Engine Power, in hp.
			track(7) ;-------------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(620) ;------------Fuel capacity in Litres.
			type(fuel) ;-----------Fuel type. (diesel OR fuel)
			range(160) ;-----------Range in km, off-road.
		)
	}

	
	
	
	
	
	



















{bone "turret"
		("turret_medium" power_traverse(24))
	}

{bone "mgun_a_rot1"
		{speed2 30}
	}

{bone "mgun_a_rot2"
		{limits -13 85}
		{speed2 60}
	}

{bone "mgun_1_rot1"
		{limits -15 15}
		{speed2 60}
	}

{bone "mgun_1_rot2"
		{limits -10 30}
		{speed2 60}
	}

{props "with_gun"}

{extender "inventory" {box








{item "ammo hmgun_usa" 700}

{item "ammo mgun_usa belt" 750}

{item "browning_m19a4" filling "ammo mgun_usa belt" 250 {user "mgun1"}}

{item "satchel_charge_usa" 1}

{item "bulletger_150_l11 he" 8}
}
{weapon "mgun1" {mask "mountable"}}
}

{sensor
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

{props "-muzzle_75mm_76mm_sides" "-muzzle_hmg_m2hb" "muzzle_150mm_155mm"}

{bone "gun_rot"
		{limits -4 55}
		{speed2 6}
	}
