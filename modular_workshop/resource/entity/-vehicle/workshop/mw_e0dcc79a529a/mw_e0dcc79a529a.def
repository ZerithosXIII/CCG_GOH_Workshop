{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "td" "light"   "shell_eject"  "detect_tank_light" "tractor" "tractor_light"  "ammo_open_top_turret" "sq_at_gun" "vision_lev03" "muzzle_75mm_76mm_sides" "open_top" "muzzle_hmg_m2hb"}
	
	
	{extension "mw_e0dcc79a529a.mdl"}

	
("ammo" args "ammo2")

("ammo" args "ammo3")

("ammo" args "ammo4")

("fuel" args "fuel1")

("fuel" args "fuel2")

("transmission" args "transmission")

{volume "body1"
		{thickness 12.7
			{rear 5}
			{bottom 8}
		}
	}

{volume "body2"
		{thickness 12.7
			{top 8}
			{rear 5}
			{bottom 8}
		}
	}

{volume "engine1"		; 
		{thickness 12.7
			{front 5}
			{bottom 8}
		}
	}

{volume "engine2"		; 
		{thickness 12.7
			{front 5}
			{top 8}
		}
	}

("shield_track" args "shield1" 15)

("gun" repair(30) thickness(25))

("ammo" args "ammo1")

{volume "turret1"		; main part
		{thickness 12.7
			{front 25.4}
			{top 8}
		}
		{able {holed}}
	}

{volume "turret2"		; back part
		{thickness 12.7
			{top 13}
		}
		{able {holed}}
	}

{volume "turret3"		; mgun mount place
		{thickness 12.7}
		{able {holed}}
	}

{volume "turret4"		; 
		{thickness 25.4}
	}

{volume "module_body"
{component "body"}

{tags "body"}
}


	;SDL
	
