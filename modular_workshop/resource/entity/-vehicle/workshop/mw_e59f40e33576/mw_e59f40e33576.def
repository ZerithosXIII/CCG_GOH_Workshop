	}
	
{sensor
		{visor "top"
			{vision "human"}
			{bone "mgun_rot"}
		}
	}
{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner3" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner"
			{group "crew"}
			{visor "main"}
			{linkbone "gunner"}
			{turnoff {sensor}}
			;{openForCrush}
		}
	}
	{placer
		{place "charger"
			{group "crew"}
			{visor "around"}
			{linkbone "charger"}
			{turnoff {sensor}}
			;{openForCrush}
		}
	}
	{placer
		{place "charger2"
			{group "crew"}
			{linkbone "charger2"}
			{turnoff}
			;{openForCrush}
