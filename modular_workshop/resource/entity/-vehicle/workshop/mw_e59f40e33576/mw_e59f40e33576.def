{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(0.9))
	{props "light"   "detect_tank_light" "tractor" "tractor_light" "sq_armor_light" "vision_lev03" "muzzle_75mm_76mm_sides" "open_top" "muzzle_hmg_m2hb"}
	
	{extension "mw_e59f40e33576.mdl"}
	(include "mw_e59f40e33576.ext")

	;SDL

	; armor notes
	; tracks and wheels 15mm
	; gun 20mm

	("tank_light_tier2")

	("tracks" repair(30) thickness(15))
	

	
	
	
	
	

	
	
	
	
	
	
	
	
	

	
	
	
	
	
	
	
	
	
	
	
	
	
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	{patherId "stuart"}
	{collider "tank.light"}

	
{boarder
		{anm "left"
			{forward {begin "board_tank"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank"}}
			{reverse {end "emit_tank_1_hold"}}
		}
	
{anm "gunner2"
			{forward {begin "board_HighArmor"} {end "pose_m5a1_late_gunner"}}
			{reverse {end "emit_tank_1"}}
		}
}

{boarder
		{door "emit0"}
		{door "emit2"}
