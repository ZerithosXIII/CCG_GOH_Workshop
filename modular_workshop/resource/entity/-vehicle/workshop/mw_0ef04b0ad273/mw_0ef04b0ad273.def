	{Weaponry
		("restore_ik_time")
		
		
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m7" filling "bulletusa_76x585 apcbche" 1}
			
			
				; general setting used by Tank Destroyers, which conserves more accuracy on the rotation of the main gun
	 ; 	spreading depending on the speed of "body", "gun" volumes
	{AccuracyByMotion
		{MaxLinearSpeed 10}				;km/h
		{ByLinearSpeed 0.4}
		{MaxAngularSpeed 8}				;deg/s
		{ByAngularSpeed 0.50}
		{DisorderTime 0.25}				;s
		{OrderTime 2.5}						;s
	}


		
