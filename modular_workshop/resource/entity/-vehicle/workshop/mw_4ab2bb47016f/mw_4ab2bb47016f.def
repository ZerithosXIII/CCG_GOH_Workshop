	{extender "enumerator"
		{digit_folder "ru1"}
	}

	
{boarder
		{anm "left"
			{forward {begin "board_tank"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank"}}
			{reverse {end "emit_tank_1_hold"}}
		}
	
{anm "cmdmg_board2"
			{forward {begin "board_Is-2"} 
{end "pose_mgun_pz6"}
}
