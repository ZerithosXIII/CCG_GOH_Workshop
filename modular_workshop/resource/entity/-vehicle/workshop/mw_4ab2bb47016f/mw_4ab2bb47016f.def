}
	{boarder
{link "emit1" "commander" {anm "cmdmg_board2"} {forward putoff} {reverse puton}}

{link "emit2" "commander" {anm "cmdmg_board3"} {forward putoff} {reverse puton}}
}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "shield" {on}}

	{extender "inventory"
		{box
					;56 rounds historical loadout ;60 rounds for late models
			
			
			{item "ammo mgun_rus dt" 2394}		;40 drums
			{item "satchel_charge_rus" 1}
			{item "ammo flame_thrower" 200}
		
{item "bulletrus_100 aphe" 13}

{item "bulletrus_100 aphebc" 5}

{item "bulletrus_100 he" 15}

{item "maxim_m09_31" filled {user "mgun1"}}

{item "ammo mgun_rus belt" 750}
}
	
{weapon "mgun1" {mask "mountable"}}
}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "100mm_d10c" filling "bulletrus_100 aphe" 1}
			
			
				; general setting used by Tank Destroyers, which conserves more accuracy on the rotation of the main gun
	 ; 	spreading depending on the speed of "body", "gun" volumes
	{AccuracyByMotion
		{MaxLinearSpeed 10}				;km/h
		{ByLinearSpeed 0.4}
		{MaxAngularSpeed 8}				;deg/s
		{ByAngularSpeed 0.50}
		{DisorderTime 0.25}				;s
		{OrderTime 3.0}						;s
	}


		
{foresight "foresight1"}

{gunner "gunner"}

{charger "charger"}

{LinkBone "gun"}
}
		{place "mgun2"
			{type "coaxial"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "flamer1"
			{type "secondary_flamer"}
			{weapon "ato_42_flame_thrower" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{basic}
			{ai_in_manual}
		}
		{##place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
	
{place "mgun1"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "cmdmg_mgun_rot2"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
}

	{mass 32000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.7))
		("mobility_tank"
			speed(55)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(9.5);---------Max speed in reverse on road, km/h. ;//7.5 historical + 2 due to terrain modifier
			traverse(36) ;-------Track traverse, per second, in degrees.
			weight(32.0) ;-------Weight in Tonnes.
			power(500) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(420) ;----------Fuel capacity in Litres.
			type(diesel) ;-------Fuel type. (diesel OR fuel)
			range(210) ;---------Range in km, off-road.
		)
	}

	
	{bone "turret" 
		("turret_medium" power_traverse(19))
	}
	{##bone "commander_rot"
		{speed2 180}
	}

{props "-muzzle_85mm_93mm" "muzzle_100mm_105mm"}

{bone "gun_rot"
		
		
	}

{bone "gun_rot"
{limits -5 20}

{speed2 5}
