{game_entity
	(include "/properties/car.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(1.0))
	(include "/properties/resupply.inc")
	{props "multi_board" "truck" "vision_lev02" "tractor" "tractor_heavy" "blast_large" "sq_ammo_supply"}
	{able "emit_on_attack"}
	
	
	{extension "mw_216206709f0f.mdl"}

	
("wheel" args "wheelright1")

("wheel" args "wheelleft1")

("wheel" args "wheelright2")

("wheel" args "wheelleft2")

("wheel" args "wheelright3")

("wheel" args "wheelleft3")

("glass" args "window1")

("glass" args "window2")

("glass" args "window3")

("glass" args "window4")

("fuel" args "fuel")

("transmission" args "transmission")

{volume "body7" {able {holed}}}

("wood" args "bodyback1")

("wood" args "bodyback2")

("wood" args "bodyback3")

{volume "shield_cover" {able {holed}}}

("turret" repair(45))

{volume "turret"		; Turret
		{thickness 10}
		{able {holed}}
		{tags "no_target"}
	}

{volume "module_hole1"
		{tags "sticky"}
	
{able clear {hole}}

{density 0}
}


	{collider "truck"}
	{patherId "gazaaa"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	
	
	
	
	
	

	
	
	
	
	
	

	("bodyback" repair(30))

	

	
	
	

	

	("truck_ammo_heavy")

	
("board_animation" place(driver)	board_begin(board_bigcar) board_end(seat_driver_car) base(doordriver))
("board_animation" place(passenger)	board_begin(board_bigcar) board_end(seat_passenger)	 base(doorpassenger))
("board_animation" place(commander)	board_begin(board_bigcar) board_end(seat_passenger)	 base(doorcommander))

{boarder
		{door "emit1"}
		
	}
{boarder
	{anm "left"
		{forward {begin "board_sd222_driver"} {end "seat_driver_car"}}
		{reverse {end "emit_sd222_driver"}}
	}
	{anm "right"
		{forward {begin "board_sd222_driver"} {end "seat_driver_car"}}
		{reverse {end "emit_sd222_driver"}}
	}
}
	{boarder
		{door "emit1"}
		{door "emit2"}
		
		
	}
	
	{boarder
		{door "emit1"}
		{door "emit2"}
		
		
	}
	
	
	
	
	{placer
		{place "driver"
			{group "crew"}
			{linkbone "driver"}
			{turnoff {sensor} {targetable 0}}
		}
	}
	{placer
		{place "gunner" {LinkBone "gunner"} {group "crew"} {visor "human"} {turnoff {targetable}{sensor}}}
	}
	{boarder
{link "emit1" "driver"  {forward putoff} {reverse puton}}
}
	{boarder
{link "emit1" "gunner" {anm "left"} {forward putoff} {reverse puton}}

{link "emit2" "gunner" {anm "right"} {forward putoff} {reverse puton}}
}
	{placer
		{place "commander"
			{group "passenger"}
			{linkbone "commander"}
			{turnoff {targetable 0}}
		}
	}
{boarder
		{door "emit2"}
		{link "emit2" "commander"  {forward putoff} {reverse puton}}
	}
	
{placer
		{place "seat1"
			{group "passenger"}
			{linkbone "seat01"}
			{turnoff {sensor} {targetable 0}}
		}
	}
{boarder
		{door "emit3"}
		{link "emit3" "seat1" {anm "passenger"} {forward putoff} {reverse puton}}
	}

	("board_animation"
		place(driver)
		board_begin(board_big-midcar_driver)
		board_end(seat_driver_car)
		base(doorleft)
	)
	("board_animation"
		place(commander)
		board_begin(board_big-midcar)
		board_end(seat_passenger)
		base(doorright)
	)

	{boarder
		{anm "passenger"
			{forward {begin "board_body"} {end "seat_passenger"} {base "board"}}
			{reverse {end "emit_body" 1} {base "board"}}
		}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "repair_kit" 5}
		
{item "ammo mgun_rus dt" 1008}

{item "dt" filling "ammo mgun_rus dt" 63 {user "mgun"}}
}
	
{weapon "mgun" {mask "mountable"}}
}

	{mass 2475}
	{Chassis
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03d") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_car"
			speed(65) ;----------------------------------Max speed.
			speedatmaxturn(17) ;-------------------------Max speed at max turn.
			reverse(20) ;--------------------------------Max speed in Reverse.
			weight(2.475) ;------------------------------Weight in Tonnes.
			power(50) ;----------------------------------Horse Power.
			fuel(100) ;-----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(145) ;---------------------------------Range in Kilometers.
		)
	}







{Weaponry
{place "mgun"
			{type "main"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		
{ai_in_manual}
}
}

{bone "mgun_rot"
		{limits -6 15}
		{speed2 20}
	}

{bone "turret"
		{speed2 30}
	}

{sensor
		{visor "human"
			{vision "recon_main"}
			{bone "visor3"}
		}
	}

{volume "mw_armor_0_v0" {tags "armor"}{thickness 5}{material "steel"}{able {NoWoundDecal}}}

{volume "mw_armor_1_v0" {tags "armor"}{thickness 5}{material "steel"}{able {NoWoundDecal}}}

{volume "mw_armor_2_v0" {tags "armor"}{thickness 5}{material "steel"}{able {NoWoundDecal}}}
}